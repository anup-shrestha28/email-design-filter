{
  "name": "@edf/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --port 3000",
    "build": "pnpm --filter @edf/render build && next build",
    "start": "next start --port 3000",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests",
    "import-fixtures": "tsx --env-file-if-exists=.env.local scripts/import-fixtures.ts",
    "seed-demo": "tsx --env-file-if-exists=../../.env.local scripts/seed-demo.ts",
    "demo-reset": "tsx --env-file-if-exists=.env.local scripts/demo-reset.ts",
    "rerender-all": "tsx --env-file-if-exists=.env.local scripts/rerender-all.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.128.0",
    "@base-ui/react": "1.8.0",
    "@better-auth/drizzle-adapter": "1.7.6",
    "@edf/budget": "workspace:*",
    "@edf/core": "workspace:*",
    "@edf/crypto": "workspace:*",
    "@edf/db": "workspace:*",
    "@edf/design": "workspace:*",
    "@edf/fetch": "workspace:*",
    "@edf/gmail": "workspace:*",
    "@edf/pipeline": "workspace:*",
    "@edf/render": "workspace:*",
    "@edf/sanitize": "workspace:*",
    "@tanstack/react-query": "5.103.2",
    "@tanstack/react-table": "9.2.4",
    "@tanstack/react-virtual": "3.14.13",
    "@vercel/functions": "3.9.9",
    "@vercel/oidc": "3.8.9",
    "@vercel/sandbox": "3.5.0",
    "better-auth": "1.7.6",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "inngest": "4.21.0",
    "jose": "6.2.12",
    "lucide-react": "1.48.0",
    "next": "16.3.6",
    "nuqs": "2.10.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "recharts": "3.10.1",
    "server-only": "0.0.1",
    "sonner": "2.0.8",
    "tailwind-merge": "3.7.0",
