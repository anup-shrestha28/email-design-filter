# Root .env.local is used by database scripts (migrations, tests). Copy to .env.local and fill in.
# Local Postgres from `pnpm db:up` (Neon-like: the owner is not a superuser but bypasses RLS).
DATABASE_URL_OWNER=postgres://neondb_owner:owner@localhost:5433/edf
DATABASE_URL_OWNER_TEST=postgres://neondb_owner:owner@localhost:5433/edf_test
# Password for the runtime role app_rw (set as a SCRAM verifier by `pnpm db:migrate`). 24+ random chars.
APP_RW_PASSWORD=
# The app's own connection string (runtime role, never the owner). Replace <APP_RW_PASSWORD> with the
# same password as above: env files do not fill one variable into another (seed-demo connects with it).
DATABASE_URL=postgres://app_rw:<APP_RW_PASSWORD>@localhost:5433/edf

# apps/web/.env.local (not this file): EDF_METER_LOCAL=1 records Vercel, Neon and Inngest usage
# locally too, exactly as on Vercel, to test the free-tier governor. Leave it unset (or 0) for normal
# local development: your laptop's usage is not platform usage and would throttle the local app.
# On Vercel everything is always metered, and so is any production build (NODE_ENV=production) whose
# DATABASE_URL isn't on this machine (not localhost / 127.0.0.1 / ::1), even without VERCEL set; a
# local `next build && next start` against the Docker database stays unmetered. Setting 0 never turns
# production metering off (docs/SETUP.md §1, §2 step 6; packages/budget/DECISIONS.md).
# EDF_METER_LOCAL=0
