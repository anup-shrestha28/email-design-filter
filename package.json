{
  "name": "email-design-filter",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.1.3",
  "engines": { "node": "24.x" },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "lint": "eslint .",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "check": "pnpm typecheck && pnpm lint && pnpm test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:up": "docker compose up -d db",
    "db:down": "docker compose down",
    "db:migrate": "pnpm --filter @edf/db migrate",
    "db:reset": "pnpm --filter @edf/db reset",
    "dev:import": "pnpm --filter @edf/web import-fixtures",
    "dev:jobs": "npx --yes inngest-cli@latest dev --port 8288 -u http://localhost:3000/api/inngest --no-discovery"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.13.6",
    "eslint": "10.11.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "prettier": "3.9.9",
    "tsx": "4.23.15",
    "turbo": "2.11.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.1",
    "vitest": "5.0.1"
  }
}
