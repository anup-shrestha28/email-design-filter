{
  "name": "@edf/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema/index.ts",
    "./migrate": "./src/migrate.ts"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "migrate": "tsx scripts/migrate.ts",
    "reset": "tsx --env-file-if-exists=../../.env.local scripts/reset.ts",
    "invite": "tsx --env-file-if-exists=../../.env.local scripts/invite.ts"
  },
  "dependencies": {
    "drizzle-orm": "0.45.3",
    "pg": "8.23.0",
    "@vercel/functions": "3.9.9",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/pg": "8.23.1",
    "drizzle-kit": "0.31.11"
  }
}
